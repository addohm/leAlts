# Packaging for the BigWigs packager (used by CurseForge and Wago release automation).
# The addon lives in leAlts/; everything else in the repository stays out of the zip.
package-as: leAlts

move-folders:
  leAlts/leAlts: leAlts

ignore:
  - tests
  - tools
  - art
  - release
  - "*.md"
  - "*.cmd"
  - .gitignore
